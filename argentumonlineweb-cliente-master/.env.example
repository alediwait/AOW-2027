# Configuración del entorno - Frontend Argentum Online Web
# Copiar este archivo como .env y completar los valores

PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/aoweb

# WebSocket
PROD_SERVER_ENDPOINT=
LOCAL_SERVER_ENDPOINT=ws://127.0.0.1:7666

# Seguridad
SESSION_SECRET=
COOKIE_DOMAIN=

# CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000
