# Configuración del entorno - Servidor Argentum Online Web
# Copiar este archivo como .env y completar los valores

NODE_ENV=development

# Puerto del servidor WebSocket
PORT=7666

# URL de MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aoweb

# Token de autorización para API
TOKEN_AUTH=

# Telegram (notificaciones)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
